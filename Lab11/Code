#include <stdio.h>
#include <math.h>

int countDigits(int num) {
    int count = 0;
    while (num != 0) {
        count++;
        num /= 10;
    }
    return count;
}
int isArmstrong(int number) {
    int original = number;
    int sum = 0;
    int digits = countDigits(number);

    while (number != 0) {
        int digit = number % 10;
        sum += pow(digit, digits);
        number /= 10;
    }

    if (sum == original)
        return 1;
    else
        return 0;
}

int main() {
    int num;

    printf("Enter Number:\n");
    scanf("%d", &num);

    if (isArmstrong(num)) {
        printf("Pass.\n");
    } else {
        printf("Not Pass.\n");
    }

    return 0;
}

