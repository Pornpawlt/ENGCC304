#include <stdio.h>

int findMax(int arr[], int size) {
    int max = arr[0];
    for (int i = 1; i < size; i++) {
        if (arr[i] > max)
            max = arr[i];
    }
    return max;
}

int findMin(int arr[], int size) {
    int min = arr[0];
    for (int i = 1; i < size; i++) {
        if (arr[i] < min)
            min = arr[i];
    }
    return min;
}

int main() {
    int arr[100];
    int n = 0;

    printf("Enter value:\n");

    while (scanf("%d", &arr[n]) == 1) {
        n++;
        if (n >= 100) break;
        if (getchar() == '\n') break;
    }

    printf("Index: ");
    for (int i = 0; i < n; i++) {
        printf("%2d ", i);
    }
    printf("\n");

    printf("Array: ");
    for (int i = 0; i < n; i++) {
        printf("%2d ", arr[i]);
    }
    printf("\n\n");

    int min = findMin(arr, n);
    int max = findMax(arr, n);

    printf("Min : %d\n", min);
    printf("Max : %d\n", max);

    return 0;
}
